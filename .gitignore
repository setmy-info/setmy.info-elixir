# Mix / Hex build output
/_build
/deps
/.fetch
*.ez
*.beam

# `mix hex.build` leaves <package>-<version>.tar in the app directory
*.tar

# ExDoc (`mix docs`), ExCoveralls (`mix coverage`), JUnit XML, SBOM,
# vulnerability reports and dependency tree (`mix reports`) output
/doc
**/doc/
/cover
**/cover/
/reports

# Runtime secrets
/config/*.secret.exs

erl_crash.dump

# Editors / language servers
.elixir_ls/
.lexical/
.idea/
*.iml
.lsp/
.vscode/

claude.session.sh
claude.session.cmd
cursor.session.sh
cursor.session.cmd
