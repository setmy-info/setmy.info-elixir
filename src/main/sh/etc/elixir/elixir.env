# Every machine. Read by setmy-info-elixir@.service before machine.env (the environment) and
# local.env (this machine, made by hand, in no package).

# systemd starts services without the PATH of a login shell: the installed Elixir and Erlang
# first, then the setmy.info scripts.
PATH=/opt/elixir/bin:/opt/erlang/bin:/opt/setmy.info/bin:/usr/local/bin:/usr/bin:/bin

LANG=C.UTF-8
